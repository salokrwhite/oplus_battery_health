#!/system/bin/sh
# ==========================================================================
#  030103  Battery health  -  CLI dispatcher
#
#  All logic (HAL/HIDL FCC read via app_process+chgfcc.dex, design capacity,
#  flag, threshold table, percent/grade arithmetic, kv/json/human output,
#  and the local HTTP server) now lives in the compiled battcore.* binary
#  next to this script - see src/battcore.c. This file only exists to pick
#  the right ABI and exec it, so every caller (service.sh, action.sh,
#  uninstall.sh, the WebUI bridge) keeps working unchanged.
#
#  Usage (unchanged):
#      batteryhealth                 human readable
#      batteryhealth --kv            key=value (WebUI)
#      batteryhealth --json          single line JSON
#      batteryhealth --kv --extra    add non-030103 telemetry
#      batteryhealth --serve         start the local web page
#      batteryhealth --serve-stop    stop it
#      batteryhealth --serve-port    print the port
# ==========================================================================

SELFDIR=${0%/*}

ABI=$(getprop ro.product.cpu.abi 2>/dev/null)
case "$ABI" in
    arm64*) BIN="$SELFDIR/battcore.arm64" ;;
    arm*)   BIN="$SELFDIR/battcore.arm" ;;
    *)
        case "$(uname -m 2>/dev/null)" in
            aarch64) BIN="$SELFDIR/battcore.arm64" ;;
            *)       BIN="$SELFDIR/battcore.arm" ;;
        esac
        ;;
esac
[ -x "$BIN" ] || BIN="$SELFDIR/battcore.arm64"
[ -x "$BIN" ] || BIN="$SELFDIR/battcore.arm"

exec "$BIN" "$@"
