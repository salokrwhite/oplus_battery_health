#!/system/bin/sh
# ==========================================================================
#  030103  Battery health  —  strict reproduction of the official flow
#
#  Nothing here is invented. Every rule below was recovered from the shipped
#  binaries and is quoted with its source.
#
#  PHONE SIDE  (com.oplus.postmanservice, class
#               com.oplus.postmanservice.charge.battery.detect.a)
#  ChargeDetectManager hard-codes item 030103 to that class:
#        if (Objects.equals(item, "030103")) result.add(a.a(item));
#  and that method does:
#        int    fcc    = OplusChargerHelper.getPsyBatteryFcc();
#        double design = new PowerProfile(ctx).getBatteryCapacity();
#        int    flag   = OplusChargerHelper.getIntegrateGaugeFccFlag();
#        double percent = (double) fcc / design * 100.0;
#        flag != 1 || percent <= 0  -> UNSUPPORTED   (errorNo "t2")
#        percent <  60.0            -> ABNORMAL      (errorNo "t03010302")
#        else                       -> NORMAL        (errorNo "t03010301")
#        params[0] = String.valueOf(percent)
#
#  PC SIDE  (ToolRecord.dll / DiagResultFilter.dll)
#        DiagResultObject::ParseBatteryCapacityFromResultReason
#        DiagResultObject::ParseSimplePercentageFormat   -> (int)percent
#        BatteryChargingResultFilter::Execute            -> good / excellent
#        DiagnosicEntry_mobile_*.json JS:
#              percent >= good      -> 优
#              percent >= excellent -> 良
#              else                 -> 差
#
#  DATA SOURCES  (official paths only, no substitution)
#        fcc    /sys/class/oplus_chg/battery/battery_fcc
#               OplusChargerHelper.getPsyBatteryFcc()
#                 -> vendor.oplus.hardware.charger.ICharger/default, trans 29
#                 -> charger HAL reads that node
#        design power_profile.xml -> battery.capacity
#               PowerProfile.getBatteryCapacity()
#        flag   /proc/charger/integrate_gauge_fcc_flag
#               getIntegrateGaugeFccFlag(): the HAL method does not exist in
#               the shipped HAL, so the code falls back to this node
#
#  If any of the three is missing the result is UNSUPPORTED - exactly what the
#  official tool does. There is no compatibility fallback.
#
#  Usage:
#      batteryhealth                 human readable
#      batteryhealth --kv            key=value (WebUI)
#      batteryhealth --json          single line JSON
#      batteryhealth --kv --extra    add non-030103 telemetry
#      batteryhealth --serve         start the local web page
#      batteryhealth --serve-stop    stop it
#      batteryhealth --serve-port    print the port
# ==========================================================================

MODID=oppo_battery_health
MODDIR=${BATTERY_HEALTH_MODDIR:-/data/adb/modules/$MODID}

MODE=human
EXTRA=0
ACTION=0
for arg in "$@"; do
    case "$arg" in
        --kv|-k)     MODE=kv ;;
        --json|-j)   MODE=json ;;
        --extra|-e)  EXTRA=1 ;;
        --action|-a) MODE=kv; ACTION=1 ;;
    esac
done

# ---------------------------------------------------------------- helpers
read1() {
    for f in "$@"; do
        [ -r "$f" ] || continue
        v=$(cat "$f" 2>/dev/null | head -n 1 | tr -d ' \t\r\n')
        if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
    done
    return 1
}

find_busybox() {
    for b in /data/adb/magisk/busybox /data/adb/ksu/bin/busybox \
             /data/adb/ap/bin/busybox /data/adb/ksud/bin/busybox \
             /system/bin/busybox ; do
        [ -x "$b" ] && { printf '%s' "$b"; return 0; }
    done
    command -v busybox 2>/dev/null && return 0
    return 1
}

# ---------------------------------------------------------------- web page
PORT=$(read1 "$MODDIR/webui_port")
[ -z "$PORT" ] && PORT=8899
PIDFILE=/data/local/tmp/oppo_battery_health_httpd.pid

# Liveness probe: a STATIC file. Probing the CGI would run a whole reading
# (app_process ~1.2 s + dumpsys ~0.2 s) and make the action button feel slow.
serve_alive() {
    BB=$(find_busybox) || return 1
    "$BB" wget -q -O /dev/null -T 2 "http://127.0.0.1:$PORT/ping.txt" 2>/dev/null
}

serve_start() {
    BB=$(find_busybox) || { echo "busybox not found, cannot start web server"; return 1; }
    [ -d "$MODDIR/webroot/cgi-bin" ] || { echo "webroot missing"; return 1; }
    chmod 0755 "$MODDIR/webroot/cgi-bin/read" 2>/dev/null
    if serve_alive; then
        echo "already running: http://127.0.0.1:$PORT/"
        return 0
    fi
    "$BB" httpd -p "127.0.0.1:$PORT" -h "$MODDIR/webroot" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    i=0
    while [ "$i" -lt 10 ]; do
        if serve_alive; then echo "http://127.0.0.1:$PORT/"; return 0; fi
        sleep 1
        i=$((i + 1))
    done
    echo "failed to start web server on port $PORT"
    rm -f "$PIDFILE"
    return 1
}

serve_stop() {
    # Kill by PID only. `pkill -f` was observed to break file access in the
    # calling shell on ColorOS, so it is deliberately not used.
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE" 2>/dev/null)
        case "$PID" in
            ''|*[!0-9]*) ;;
            *) kill "$PID" 2>/dev/null ;;
        esac
        rm -f "$PIDFILE"
    fi
    return 0
}

case "$1" in
    --serve)      serve_start; exit $? ;;
    --serve-stop) serve_stop;  echo "stopped"; exit 0 ;;
    --serve-port) echo "$PORT"; exit 0 ;;
esac

# --action: start the web page, open it, then take one reading - all in one
# process, so the browser is opened before the (slower) reading and the caller
# needs a single invocation.
SERVE_URL=""
if [ "$ACTION" = "1" ]; then
    r=$(serve_start 2>&1 | tail -n 1)
    case "$r" in
        *http*) SERVE_URL="http${r#*http}" ;;   # strip an "already running: " prefix
    esac
    # Open the browser straight away. The reading below needs ~1.7 s (app_process
    # + dumpsys) and the page performs its own read anyway, so there is no reason
    # to make the user wait for it.
    if [ -n "$SERVE_URL" ]; then
        U=$(am get-current-user 2>/dev/null)
        case "$U" in ''|*[!0-9]*) U=0 ;; esac
        am start --user "$U" -a android.intent.action.VIEW -d "$SERVE_URL" >/dev/null 2>&1
    fi
    # --action is purely "open the page": no reading here. The page reads by
    # itself once it loads, and each press of its button reads again.
    echo "url=$SERVE_URL"
    exit 0
fi

# ==========================================================================
#  1. FCC  —  OplusChargerHelper.getPsyBatteryFcc()
#
#  Official sequence (decompiled):
#
#      getOplusCharger():
#          1) AIDL   vendor.oplus.hardware.charger.ICharger/default
#                    ICharger$Stub.asInterface(ServiceManager.getService(...))
#          2) HIDL   vendor.oplus.hardware.charger.V1_0.ICharger.getService()
#      invokeChargeInterface("getPsyBatteryFcc"):
#          svc.getPsyBatteryFcc()  via reflection
#          -> returns -1 on any failure
#
#  Reproduced here as far as a shell can go:
#      * AIDL - transaction 29 is TRANSACTION_getPsyBatteryFcc (read out of both
#        the V1 and V3 java stubs, identical). The HAL is lazy, so it is woken
#        with ctl.start first, exactly like ServiceManager.getService() would.
#      * HIDL - hwbinder has no shell client, so a HIDL-only charger HAL cannot
#        be called from a script at all.
#      * When the HAL cannot be reached the value is read from the node that
#        HAL serves (the HAL binary's only FCC path). fcc_src always states
#        which of the two was used, and fcc_hal/fcc_node expose both.
# ==========================================================================
FCC_NODE=/sys/class/oplus_chg/battery/battery_fcc
CHG_DEX="$MODDIR/bin/chgfcc.dex"
HAL_FCC=""
HAL_VIA=""

# The official sequence is executed by a small DEX launched with app_process,
# because a shell cannot reach hwbinder. See src/ChgFcc.java:
#     AIDL  vendor.oplus.hardware.charger.ICharger/default
#     HIDL  vendor.oplus.hardware.charger.V1_0.ICharger
hal_fcc() {
    [ -f "$CHG_DEX" ] || return 1
    command -v app_process >/dev/null 2>&1 || return 1
    CP="$CHG_DEX"
    for j in /system_ext/framework/vendor.oplus.hardware.charger-V1-java.jar \
             /system_ext/framework/vendor.oplus.hardware.charger-V3-java.jar \
             /system_ext/framework/vendor.oplus.hardware.charger-V1.0-java.jar \
             /odm/framework/vendor.oplus.hardware.charger-V1-java.jar \
             /odm/framework/vendor.oplus.hardware.charger-V1.0-java.jar ; do
        [ -f "$j" ] && CP="$CP:$j"
    done
    out=$(CLASSPATH="$CP" app_process /system/bin ChgFcc 2>/dev/null) || return 1
    v=$(printf '%s\n' "$out" | sed -n 's/^fcc=//p' | head -n 1)
    w=$(printf '%s\n' "$out" | sed -n 's/^via=//p' | head -n 1)
    case "$v" in ''|*[!0-9-]*) return 1 ;; esac
    HAL_FCC=$v
    HAL_VIA=$w
    return 0
}

FCC=""
FCC_SRC=""
FCC_NODE_V=$(read1 "$FCC_NODE")

if hal_fcc && [ "$HAL_FCC" -gt 0 ] 2>/dev/null && [ "$HAL_FCC" -lt 100000 ] 2>/dev/null; then
    FCC=$HAL_FCC
    FCC_SRC="hal:$HAL_VIA (app_process ChgFcc)"
else
    FCC=$FCC_NODE_V
    [ -n "$FCC" ] && FCC_SRC="$FCC_NODE (HAL unavailable)"
fi

# ==========================================================================
#  2. design  —  PowerProfile.getBatteryCapacity()
#     read from the framework power profile (Android overlay precedence)
# ==========================================================================
DESIGN=""
DESIGN_SRC=""

# Primary: the framework's own value. BatteryStatsService builds its
# PowerProfile exactly like the diagnostic plugin does and prints the result,
# so this is the very number the official code reads.
v=$(dumpsys batterystats 2>/dev/null \
    | grep -m1 'Estimated battery capacity' \
    | grep -o '[0-9][0-9]*' | head -n 1)
if [ -n "$v" ]; then
    DESIGN=$v
    DESIGN_SRC="dumpsys batterystats (PowerProfile)"
fi
# Fallback: the overlay XML the framework resource resolves from (same value),
# used only when the framework dump above is unavailable.
if [ -z "$DESIGN" ]; then
for f in /odm/etc/power_profile/power_profile.xml \
         /vendor/etc/power_profile/power_profile.xml \
         /system_ext/etc/power_profile/power_profile.xml \
         /system/etc/power_profile.xml ; do
    [ -r "$f" ] || continue
    v=$(sed -n 's/.*name="battery.capacity"[^>]*>\([0-9][0-9.]*\)<.*/\1/p' "$f" 2>/dev/null | head -n 1)
    if [ -n "$v" ]; then DESIGN=$v; DESIGN_SRC=$f; break; fi
done
fi

# ==========================================================================
#  3. flag  —  getIntegrateGaugeFccFlag()
#
#  Official code:
#      int f = invokeChargeInterface("getIntegrateGaugeFccFlag");
#      if (f != 1)
#          return new File("proc/charger/integrate_gauge_fcc_flag").exists() ? 1 : 0;
#      return f;
#
#  The AIDL method is absent from every shipped charger interface
#  (V1 / V1.0 / V3 all lack it), so the branch above is always taken and the
#  answer is purely "does the file exist" - the file CONTENT is never read.
# ==========================================================================
FLAG=0
[ -e /proc/charger/integrate_gauge_fcc_flag ] && FLAG=1

# ==========================================================================
#  4. thresholds  —  DynamicConfig.json / BatteryChargingResultFilter
#     default good=80 excellent=60
#     special 20031,20061,19815,19525 -> good=70 excellent=60
# ==========================================================================
GOOD=80
EXCELLENT=60
PROJ=$(getprop ro.separate.soft)
[ -z "$PROJ" ] && PROJ=$(getprop ro.oplus.image.my_product.type)
case " 20031 20061 19815 19525 " in
    *" $PROJ "*) GOOD=70; EXCELLENT=60 ;;
esac

# The official detail text renders exactly this legend next to the grade:
#   resultText+='优：'+good+'-100%，良：'+excellent+'-'+good+'%，差：0-'+excellent+'%'
LEGEND="优：${GOOD}-100%，良：${EXCELLENT}-${GOOD}%，差：0-${EXCELLENT}%"

# ==========================================================================
#  5. compute  —  exactly the phone-side arithmetic, then the PC grading
# ==========================================================================
case "$FCC" in ''|*[!0-9-]*) FCC="";; esac
case "$DESIGN" in ''|*[!0-9.]*) DESIGN="";; esac

if [ -z "$FCC" ] || [ -z "$DESIGN" ]; then
    STATUS=unsupported
    PCT=""; PCT_RAW=""; PCT_INT=""; PCT_EXACT=""
else
    # identical expression to the phone side: (double) fcc / design * 100.0
    PCT_RAW=$(awk -v f="$FCC" -v d="$DESIGN" 'BEGIN{ if (d>0) printf "%.10f", f*100.0/d; else print "0" }')
    # percent   : the ratio shown with 2 decimals (display value)
    # ratio_exact: the unrounded ratio the grade is actually computed from
    # percent_int: the (int) cast the PC stores in its record
    PCT=$(awk -v p="$PCT_RAW" 'BEGIN{ printf "%.2f", p }')
    PCT_EXACT=$(awk -v p="$PCT_RAW" 'BEGIN{ printf "%.17g", p }')
    PCT_INT=$(awk -v p="$PCT_RAW" 'BEGIN{ printf "%d", p }')

    if [ "$FLAG" != "1" ]; then
        STATUS=unsupported
    elif [ "$(awk -v p="$PCT_RAW" 'BEGIN{print (p>0)?1:0}')" != "1" ]; then
        STATUS=unsupported
    elif [ "$(awk -v p="$PCT_RAW" 'BEGIN{print (p<60.0)?1:0}')" = "1" ]; then
        STATUS=abnormal
    else
        STATUS=normal
    fi
fi

if [ -z "$PCT" ]; then
    LEVEL="-"
    LEVEL_EN="-"
    ITEMNO="-"
elif [ "$STATUS" = "unsupported" ]; then
    LEVEL="-"
    LEVEL_EN="-"
    ITEMNO="t2"
elif [ "$STATUS" = "abnormal" ]; then
    LEVEL="不通过：差"
    LEVEL_EN="Fail: Poor"
    ITEMNO="t03010302"
else
    LEVEL=$(awk -v p="$PCT_RAW" -v g="$GOOD" -v e="$EXCELLENT" \
            'BEGIN{ if(p>=g) print "优"; else if(p>=e) print "良"; else print "差" }')
    LEVEL_EN=$(awk -v p="$PCT_RAW" -v g="$GOOD" -v e="$EXCELLENT" \
            'BEGIN{ if(p>=g) print "Excellent"; else if(p>=e) print "Good"; else print "Poor" }')
    ITEMNO="t03010301"
fi

# ==========================================================================
#  6. optional telemetry (NOT part of 030103, only with --extra)
# ==========================================================================
SOC=""; VOLT_MV=""; CURR_MA=""; TEMP_C=""; CHG_STATE=""; HEALTH_RAW=""; CYCLES=""; UEV=""
if [ "$EXTRA" = "1" ]; then
    for f in /sys/class/power_supply/battery/uevent /sys/class/power_supply/main/uevent \
             /sys/class/power_supply/bms/uevent ; do
        [ -r "$f" ] && { UEV=$f; break; }
    done
    uev() {
        [ -n "$UEV" ] || return 1
        grep -m1 "^POWER_SUPPLY_$1=" "$UEV" 2>/dev/null | cut -d= -f2- | tr -d ' \t\r\n'
    }
    SOC=$(uev CAPACITY)
    VOLT_MV=$(uev VOLTAGE_NOW)
    CURR_MA=$(uev CURRENT_NOW)
    TEMP_C=$(awk -v t="$(uev TEMP)" 'BEGIN{ if(t==""){print ""} else printf "%.1f", t/10 }')
    CHG_STATE=$(uev STATUS)
    HEALTH_RAW=$(uev HEALTH)
    CYCLES=$(read1 /sys/class/power_supply/battery/cycle_count \
                   /sys/class/power_supply/main/cycle_count \
                   /sys/class/power_supply/bms/cycle_count)
fi

# ==========================================================================
#  7. output
# ==========================================================================
if [ "$MODE" = "kv" ]; then
    cat <<EOF
ok=$([ -n "$PCT" ] && echo 1 || echo 0)
level=$LEVEL
level_en=$LEVEL_EN
legend=$LEGEND
status=$STATUS
item_no=$ITEMNO
flag=$FLAG
good=$GOOD
excellent=$EXCELLENT
project=$PROJ
fcc=$FCC
fcc_hal=$HAL_FCC
fcc_hal_via=$HAL_VIA
fcc_node=$FCC_NODE_V
design=$DESIGN
fcc_src=$FCC_SRC
design_src=$DESIGN_SRC
percent=$PCT
percent_int=$PCT_INT
ratio_exact=$PCT_EXACT
model=$(getprop ro.product.model)
device=$(getprop ro.product.device)
rom=$(getprop ro.build.version.oplusrom)
time=$(date +%Y-%m-%dT%H:%M:%S)
EOF
    [ "$ACTION" = "1" ] && echo "url=$SERVE_URL"
    if [ "$EXTRA" = "1" ]; then
        cat <<EOF
soc=$SOC
voltage_mv=$VOLT_MV
current_ma=$CURR_MA
temp_c=$TEMP_C
charge_status=$CHG_STATE
health=$HEALTH_RAW
cycle_count=$CYCLES
uevent=$UEV
EOF
    fi

elif [ "$MODE" = "json" ]; then
    j() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
    printf '{"ok":%s,"level":"%s","level_en":"%s","legend":"%s","status":"%s","item_no":"%s","flag":"%s","good":"%s","excellent":"%s","project":"%s","fcc":"%s","design":"%s","percent":"%s","percent_int":"%s","ratio_exact":"%s"}\n' \
        "$([ -n "$PCT" ] && echo true || echo false)" "$(j "$LEVEL")" "$(j "$LEVEL_EN")" "$(j "$LEGEND")" \
        "$(j "$STATUS")" "$(j "$ITEMNO")" "$(j "$FLAG")" "$(j "$GOOD")" "$(j "$EXCELLENT")" \
        "$(j "$PROJ")" "$(j "$FCC")" "$(j "$DESIGN")" \
        "$(j "$PCT")" "$(j "$PCT_INT")" "$(j "$PCT_EXACT")"

else
    cat <<EOF
电池健康 (030103)
  percent      = ${PCT:-不可用}${PCT:+ %}        (原始数据，两位小数)
  level        = ${LEVEL}
  legend       = ${LEGEND}
  status       = ${STATUS}
  item_no      = ${ITEMNO}

  fcc          = ${FCC:-?} mAh    [${FCC_SRC:-未找到}]
  design       = ${DESIGN:-?} mAh    [${DESIGN_SRC:-未找到}]
  flag         = ${FLAG}
  thresholds   = good>=${GOOD}, excellent>=${EXCELLENT}   (project ${PROJ:-unknown})

  判级与记录（等级用未舍入值判定，与官方一致）:
    ratio_exact= ${PCT_EXACT:-不可用}
    record_int = ${PCT_INT:-不可用}
EOF
    if [ "$EXTRA" = "1" ]; then
        cat <<EOF

  附加信息 (非 030103 内容):
    soc        = ${SOC:-?}
    voltage    = ${VOLT_MV:-?} mV
    current    = ${CURR_MA:-?} mA
    temperature= ${TEMP_C:-?} C
    charge     = ${CHG_STATE:-?}
    health     = ${HEALTH_RAW:-?}
    cycles     = ${CYCLES:-?}
EOF
    fi
fi

# No result files and no properties are written: the script only prints.
exit 0
